{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$version": "1.2",
  "$description": "Gensyn Design interaction and status tokens — August 2026.",

  "state": {
    "surface": {
      "input":            { "$value": "#FCFBF9", "$type": "color", "$description": "Rest background for inputs and textareas — a half-step off surface white" },
      "hover":            { "$value": "{color.neutral.100}", "$type": "color", "$description": "Hover fill for selectable rows and options" },
      "selected":         { "$value": "{color.brand.navy-accent}", "$type": "color", "$description": "Selected fill — pair with navy text" },
      "selected-secondary": { "$value": "{color.brand.purple-accent}", "$type": "color", "$description": "Selected fill in purple-keyed contexts" },
      "disabled":         { "$value": "{color.neutral.100}", "$type": "color" }
    },
    "opacity": {
      "disabled": { "$value": 0.4, "$type": "number" },
      "muted":    { "$value": 0.7, "$type": "number" }
    },
    "status": {
      "error":          { "$value": "#B3261E", "$type": "color", "$description": "Error text, borders, icons. 6.0:1 on linen." },
      "error-surface":  { "$value": "#FBEEED", "$type": "color", "$description": "Error message background" },
      "error-border":   { "$value": "#E8BFBC", "$type": "color" },
      "warning":        { "$value": "#7A4A08", "$type": "color", "$description": "Warning text — a darkened Orange Peel that passes contrast. 6.9:1 on linen." },
      "warning-surface": { "$value": "#FDF3E3", "$type": "color" },
      "warning-border": { "$value": "{color.accent.orange}", "$type": "color" },
      "success":        { "$value": "{color.accent.green}", "$type": "color", "$description": "Graphic role — icon, border, fill" },
      "success-text":   { "$value": "{color.accent.green-dark}", "$type": "color", "$description": "Text role — the darkened green, since Dark Spring Green is a graphics color" },
      "success-surface": { "$value": "#E9F2EE", "$type": "color" },
      "success-border": { "$value": "#A9CCBD", "$type": "color" },
      "info":           { "$value": "{color.brand.navy}", "$type": "color", "$description": "Navy is a text-safe brand color — no separate text variant needed" },
      "info-surface":   { "$value": "#EDEFFA", "$type": "color" },
      "info-border":    { "$value": "{color.brand.navy-accent}", "$type": "color" }
    }
  }
}
